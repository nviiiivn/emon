# Seeder-only settings (read by scripts/run-seeders.sh after .env). No secrets here.
# Forecast stages only use the local model when no OpenRouter key is present, and gemma's "thinking"
# returns empty text on that path, so forecasts use granite4.1:8b (tested 2026-11-20: all stages succeed).
unset OPENROUTER_API_KEY
LLM_MODEL=granite4.1:8b
